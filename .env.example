# ===== brawl-draft-core 环境变量模板 =====
# 复制为 .env 后填写。所有项均有默认值，除 BRAWL_API_KEY 外均可留空。

# --- Supercell 官方 API ---
# 从 https://developer.brawlstars.com 申请，格式为 JWT
BRAWL_API_KEY=

# API 根地址。默认走 RoyaleAPI 社区中转代理：
# 中转侧用固定出口访问官方接口，本地网络出口 IP 频繁变动也不会再触发 403 Invalid IP。
# 若需直连官方，改成 https://api.brawlstars.com/v1 —— 但官方直连要求把出口 IP 加入
# 白名单，IP 一变就会 403，一般只在固定 IP 的服务器上使用。
# 末尾斜杠可写可不写，程序会自动归一化，不会拼出双斜杠。
BRAWL_API_BASE_URL=https://bsproxy.royaleapi.dev/v1

# 可选：出站代理，支持 http:// 与 socks5://（socks5h:// 亦可）
# 国内访问 bsproxy.royaleapi.dev 仍建议挂本地代理节点；区别在于中转代理不要求
# 本地节点的出口 IP 固定，换节点不会导致 403。
# PROXY_URL=socks5://127.0.0.1:1080
PROXY_URL=

# --- 采集参数 ---
# 单轮抓取的最大玩家数
CRAWL_LIMIT=200
# 异步并发上限（Supercell 限流较严，建议 5~10）
CRAWL_CONCURRENCY=10
# 429 / 5xx 的最大重试次数
CRAWL_MAX_RETRIES=3
# 已抓取玩家的重新排队间隔（小时）：窗口内不会重复拉取，0 表示每轮都可重抓。
# 玩家总数小于单轮 limit 时，这个窗口是避免「每轮重扫同一批人」的关键。
CRAWL_REFRESH_HOURS=6

# --- 数据过滤 ---
# 赛季重置时间（含）之前的对局一律丢弃，格式 YYYY-MM-DD
# 往前放宽可吸纳更多存量排位记录；注意 battlelog 只暴露最近约 25 场，
# 放宽窗口不会凭空变出更早的对局，只影响「重抓同一玩家时旧对局是否保留」。
SEASON_START_DATE=2026-07-20
# 段位阈值：对局 6 人平均排位段位低于该值则丢弃（1~22）
# 1~3 青铜 / 4~6 白银 / 7~9 黄金 / 10~12 钻石 / 13~15 神话 / 16~18 传奇 / 19~21 大师 / 22 职业
# 默认 16 = 传奇 I 及以上
MIN_TIER=16
# 雪球扩充入队门槛：本局段位 >= 该值的玩家才会被加入待抓取队列
# 默认 15 = 神话 III（只向下放宽一档，避免队列被低分段稀释）
ENQUEUE_MIN_TIER=15

# --- 统计参数 ---
# 贝叶斯平滑先验权重 m（胜率）
BAYES_PRIOR_WEIGHT=50
# 1v1 克制矩阵最小交锋样本量。
# 注意：已由分层有效样本门槛取代（地图级 eff_n >= 8、模式级 eff_n >= 12，
# 全局兜底表 n >= 10，见 analyzer 的 *_MIN_EFF_SAMPLES / GLOBAL_MATCHUP_MIN_SAMPLES），
# 本项仅保留兼容，不再影响导出。
MATCHUP_MIN_SAMPLES=6

# --- 存储与发布 ---
DATABASE_PATH=brawl.db
DIST_PATH=dist/brawl_meta.json
ROLES_PATH=config/brawler_roles.json
# 发布分支与远端
GIT_REMOTE=origin
GIT_BRANCH=main
